{
    "preset": "laravel",
    "rules": {
        "concat_space": {
            "spacing": "one"
        },
        "array_syntax": {
            "syntax": "short"
        },
        "binary_operator_spaces": {
            "default": "align_single_space_minimal"
        },
        "no_unused_imports": true
    },
    "exclude": [
        "tests",
        "config"
    ]
}